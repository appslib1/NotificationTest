<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/lab_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="10dp"
        android:paddingBottom="28dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_sheet_handle"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_schedule"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.01"
            android:textColor="@color/lab_on_surface"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/schedule_hint"
            android:textSize="14sp"
            android:textColor="@color/lab_on_surface_variant"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_time_display"
            android:padding="22dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_clock"
                    app:tint="@color/lab_primary"
                    android:contentDescription="@null"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/when_label"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.10"
                    android:textColor="@color/lab_on_surface_variant"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/scheduled_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.02"
                android:textColor="@color/lab_on_surface"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/choose_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:textAllCaps="false"
            android:text="@string/choose_date"
            android:textSize="15sp"
            android:layout_marginTop="14dp"
            app:cornerRadius="22dp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            app:icon="@drawable/ic_calendar"
            app:iconGravity="textStart"
            app:strokeColor="@color/lab_border"
            android:textColor="@color/lab_on_surface"
            app:iconTint="@color/lab_primary"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/repeat_label"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.10"
            android:textColor="@color/lab_on_surface_variant"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/repeat_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/repeat_none"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:minWidth="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:text="@string/repeat_none"
                android:textAllCaps="false"
                android:textSize="13sp"
                app:strokeColor="@color/lab_border"
                android:textColor="@color/lab_on_surface"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/repeat_daily"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:minWidth="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:text="@string/repeat_daily"
                android:textAllCaps="false"
                android:textSize="13sp"
                app:strokeColor="@color/lab_border"
                android:textColor="@color/lab_on_surface"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/repeat_weekly"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:minWidth="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:text="@string/repeat_weekly"
                android:textAllCaps="false"
                android:textSize="13sp"
                app:strokeColor="@color/lab_border"
                android:textColor="@color/lab_on_surface"/>
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/schedule_note"
            android:textSize="13sp"
            android:textColor="@color/lab_on_surface_variant"
            android:background="@drawable/bg_info_note"
            android:padding="14dp"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="2dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/schedule"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:textAllCaps="false"
            android:text="@string/schedule"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="18dp"
            app:cornerRadius="22dp"
            app:icon="@drawable/ic_clock"
            app:iconGravity="textStart"
            app:backgroundTint="@color/lab_accent"
            android:textColor="@color/lab_on_accent"
            app:iconTint="@color/lab_on_accent"
            app:rippleColor="#33FFFFFF"/>
    </LinearLayout>
</ScrollView>
