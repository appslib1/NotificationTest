<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/lab_background"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/notification_test"
                android:textColor="@color/lab_on_surface"
                android:textSize="24sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.02"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/header_subtitle"
                android:textColor="@color/lab_on_surface_variant"
                android:textSize="13sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rate_button"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:contentDescription="@string/rate"
            android:background="@drawable/bg_settings_button"
            app:icon="@drawable/baseline_favorite_border_24"
            app:iconSize="22dp"
            app:iconPadding="0dp"
            app:iconGravity="textStart"
            app:iconTint="@color/lab_on_surface"
            app:backgroundTint="@android:color/transparent"
            app:strokeWidth="0dp"
            app:cornerRadius="22dp"
            app:rippleColor="?attr/colorControlHighlight"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/notification_settings"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:contentDescription="@string/settings"
            android:background="@drawable/bg_settings_button"
            app:icon="@drawable/ic_settings"
            app:iconSize="20dp"
            app:iconPadding="0dp"
            app:iconGravity="textStart"
            app:iconTint="@color/lab_on_surface"
            app:backgroundTint="@android:color/transparent"
            app:strokeWidth="0dp"
            app:cornerRadius="22dp"
            app:rippleColor="?attr/colorControlHighlight"/>
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/lab_background"
        app:tabIndicatorColor="@color/lab_accent"
        app:tabIndicatorHeight="3dp"
        app:tabIndicatorFullWidth="false"
        app:tabIndicator="@drawable/bg_tab_indicator"
        app:tabSelectedTextColor="@color/lab_on_surface"
        app:tabTextColor="@color/lab_on_surface_variant"
        app:tabMode="fixed"
        app:tabGravity="fill"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:tabTextAppearance="@style/LabTabText"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/compose_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:fillViewport="true"
                android:layout_weight="1"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:paddingTop="16dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp"
                        app:cardBackgroundColor="@android:color/transparent">

                        <LinearLayout
                            android:id="@+id/composer_fields"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="22dp"
                            android:paddingEnd="22dp"
                            android:paddingTop="22dp"
                            android:paddingBottom="18dp"
                            android:background="@drawable/bg_composer">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:background="@drawable/bg_badge"
                                android:paddingStart="10dp"
                                android:paddingEnd="14dp"
                                android:paddingTop="7dp"
                                android:paddingBottom="7dp">
                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:src="@drawable/ic_notification"
                                    app:tint="@color/lab_primary"
                                    android:contentDescription="@null"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/composer_badge"
                                    android:textSize="10sp"
                                    android:fontFamily="sans-serif-medium"
                                    android:textColor="@color/lab_on_surface"
                                    android:letterSpacing="0.12"
                                    android:layout_marginStart="6dp"/>
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/compose_heading"
                                android:textSize="26sp"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="@color/lab_on_surface"
                                android:letterSpacing="-0.02"
                                android:layout_marginTop="16dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/compose_subtitle"
                                android:textSize="14sp"
                                android:textColor="@color/lab_on_surface_variant"
                                android:layout_marginTop="4dp"/>

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/title_hint"
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                android:layout_marginTop="18dp"
                                app:boxStrokeWidth="0dp"
                                app:boxStrokeWidthFocused="0dp"
                                app:boxBackgroundColor="@android:color/transparent"
                                app:hintTextColor="@color/lab_on_surface_variant"
                                android:textColorHint="@color/lab_on_surface_variant">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/notification_title"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="textCapSentences"
                                    android:minLines="1"
                                    android:maxLines="1"
                                    android:maxLength="150"
                                    android:paddingStart="0dp"
                                    android:paddingEnd="0dp"
                                    android:background="@null"
                                    android:textSize="19sp"
                                    android:textColor="@color/lab_on_surface"
                                    android:fontFamily="sans-serif-medium"/>
                            </com.google.android.material.textfield.TextInputLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/lab_divider"
                                android:layout_marginTop="4dp"
                                android:layout_marginBottom="4dp"
                                android:alpha="0.6"/>

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/description_hint"
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                app:boxStrokeWidth="0dp"
                                app:boxStrokeWidthFocused="0dp"
                                app:boxBackgroundColor="@android:color/transparent"
                                app:hintTextColor="@color/lab_on_surface_variant"
                                android:textColorHint="@color/lab_on_surface_variant">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/notification_description"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="textCapSentences|textMultiLine"
                                    android:minLines="2"
                                    android:maxLines="4"
                                    android:maxLength="2000"
                                    android:paddingStart="0dp"
                                    android:paddingEnd="0dp"
                                    android:background="@null"
                                    android:textSize="15sp"
                                    android:textColor="@color/lab_on_surface"/>
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/open_appearance"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="64dp"
                        android:text="@string/customize"
                        android:textAllCaps="false"
                        android:textSize="15sp"
                        android:gravity="start|center_vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        app:icon="@drawable/ic_image"
                        app:iconSize="22dp"
                        app:iconPadding="14dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_customize_row"
                        app:backgroundTint="@android:color/transparent"
                        app:cornerRadius="22dp"
                        app:strokeWidth="0dp"
                        android:textColor="@color/lab_on_surface"
                        app:iconTint="@color/lab_primary"
                        app:rippleColor="?attr/colorControlHighlight"/>
                </LinearLayout>
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="4dp"
                android:paddingBottom="20dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/send_now"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="60dp"
                    android:text="@string/send_now"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    app:cornerRadius="22dp"
                    app:icon="@drawable/ic_send"
                    app:iconSize="20dp"
                    app:iconPadding="10dp"
                    app:iconGravity="textStart"
                    app:backgroundTint="@color/lab_accent"
                    android:textColor="@color/lab_on_accent"
                    app:iconTint="@color/lab_on_accent"
                    app:rippleColor="#33FFFFFF"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/open_schedule"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="10dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:contentDescription="@string/schedule"
                    app:cornerRadius="22dp"
                    app:icon="@drawable/ic_clock"
                    app:iconSize="22dp"
                    app:iconPadding="0dp"
                    app:iconGravity="textStart"
                    app:backgroundTint="@color/lab_primary_container"
                    app:iconTint="@color/lab_primary"/>
            </LinearLayout>
        </LinearLayout>

        <ScrollView
            android:id="@+id/scheduled_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/list_page_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:paddingTop="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:paddingBottom="12dp"
                    android:textSize="20sp"
                    android:id="@+id/scheduled_count"
                    android:textColor="@color/lab_on_surface"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.01"/>

                <LinearLayout
                    android:id="@+id/empty_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_empty"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="36dp"
                    android:paddingBottom="36dp"
                    android:layout_marginBottom="16dp">

                    <FrameLayout
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/bg_empty_icon">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_clock"
                            app:tint="@color/lab_primary"
                            android:contentDescription="@null"/>
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/empty_title"
                        android:textSize="17sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/lab_on_surface"
                        android:layout_marginTop="16dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/empty_hint"
                        android:textSize="14sp"
                        android:textColor="@color/lab_on_surface_variant"
                        android:gravity="center"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/scheduled_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/ad_view_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:background="@color/lab_background"/>
</LinearLayout>
